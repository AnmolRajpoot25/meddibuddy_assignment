# OpenRouter API Key for free tier models (e.g. meta-llama/llama-3.3-70b-instruct:free)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model Selection (defaults to free tier nvidia/nemotron-3.5-lightning:free)
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Server Host & Port
HOST=127.0.0.1
PORT=8000
